CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r28s=y

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=256

CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_EXT4_BLOCKSIZE=4096
CONFIG_TARGET_EXT4_JOURNAL=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0

CONFIG_PACKAGE_kmod-r8169=y

# Match the stock radxa_e20c image: same target, same subtarget and the same
# DEVICE_PACKAGES, so the only thing to add is the LuCI stack. The rest of that
# image is the target's DEFAULT_PACKAGES plus these dependencies.
# Reference: openwrt-25.12.5-rockchip-armv8.manifest under
# https://downloads.openwrt.org/releases/25.12.5/targets/rockchip/armv8/
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y

# Not in the stock image, requested explicitly: the netlink connection tracking
# interface (nf_conntrack_netlink.ko), which libnetfilter-conntrack needs.
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# CONFIG_CCACHE has a prompt gated on DEVEL, so without DEVEL `make defconfig`
# silently drops it. OpenWrt's own CI sets CONFIG_DEVEL=y for the same reason.
# DEVEL only reveals developer prompts; it does not change existing defaults.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
